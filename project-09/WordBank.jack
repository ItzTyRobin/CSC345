class WordBank {

    field Array words;
    field int   count;
    field int seed;

    constructor WordBank new(int startSeed) {
        var Array w;

        let count = 8;
        let seed = startSeed;
        let words = Array.new(count);

        // brick
        let w = Array.new(5);
        let w[0]=98; let w[1]=114; let w[2]=105; let w[3]=99; let w[4]=107;
        let words[0] = w;

        // crane
        let w = Array.new(5);
        let w[0]=99; let w[1]=114; let w[2]=97; let w[3]=110; let w[4]=101;
        let words[1] = w;

        // flame
        let w = Array.new(5);
        let w[0]=102; let w[1]=108; let w[2]=97; let w[3]=109; let w[4]=101;
        let words[2] = w;

        // ghost
        let w = Array.new(5);
        let w[0]=103; let w[1]=104; let w[2]=111; let w[3]=115; let w[4]=116;
        let words[3] = w;

        // plant
        let w = Array.new(5);
        let w[0]=112; let w[1]=108; let w[2]=97; let w[3]=110; let w[4]=116;
        let words[4] = w;

        // queen
        let w = Array.new(5);
        let w[0]=113; let w[1]=117; let w[2]=101; let w[3]=101; let w[4]=110;
        let words[5] = w;

        // storm
        let w = Array.new(5);
        let w[0]=115; let w[1]=116; let w[2]=111; let w[3]=114; let w[4]=109;
        let words[6] = w;

        // world
        let w = Array.new(5);
        let w[0]=119; let w[1]=111; let w[2]=114; let w[3]=108; let w[4]=100;
        let words[7] = w;

        return this;
    }


    method int wrapIndex(int value) {
        while ((value > count) | (value = count)) {
            let value = value - count;
        }
        return value;
    }

    method Array pickWord() {
    let seed = wrapIndex(seed + 1);
    return getWord(seed);
}

    method Array getWord(int index) {
        return words[index];
    }

    method int getCount() {
        return count;
    }

    method void dispose() {
        var int i;
        var Array w;
        let i = 0;
        while (i < count) {
            let w = words[i];
            do w.dispose();
            let i = i + 1;
        }
        do words.dispose();
        do Memory.deAlloc(this);
        return;
    }
}