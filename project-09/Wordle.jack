class Wordle {

    // the current guess being typed
    field Array currentGuess;
    field int guessLength;      
    field int currentRow;    

    field Array target; 

    field Board board; 
    field WordleKeyboard keyBoard; 
    field WordBank wordBank; 

    constructor Wordle new() {

        let currentGuess = Array.new(5);
        let guessLength = 0;
        let currentRow = 0;

        let wordBank = WordBank.new(); 
        let board = Board.new(); 
        let keyBoard = WordleKeyboard.new(); 
        
        let target = wordBank.pickWord(); // need to change to choose a random word in word bank but not hard code 

        do board.clearStatusLine();

        return this;
    }

    method void run() {
        var char key;
        var int  i;

        while (currentRow < 6) {

            let key = keyBoard.getKey();
            while (key = 0) {
                let key = Keyboard.keyPressed();
            }

            // backspace
            if (key = 129) {
                if (guessLength > 0) {
                    let guessLength = guessLength - 1;
                    do board.clearCell(currentRow, guessLength);
                    do board.clearStatusLine();
                }
            }

            // enter
            if (key = 128) {
                if (guessLength = 5) {
                    let currentRow  = currentRow + 1;
                    let guessLength = 0;
                    do board.clearStatusLine();
                } else {
                    do board.clearStatusLine();
                    do Output.printString("Need 5 letters");
                }
            }

            // a-z
            if ((key > 96) & (key < 123)) {
                if (guessLength < 5) {
                    let currentGuess[guessLength] = key;
                    do board.putLetterInCell(currentRow, guessLength, key);
                    let guessLength = guessLength + 1;
                } else {
                    do board.clearStatusLine();
                    do Output.printString("Already 5 letters");
                }
            }

            // A-Z
            if ((key > 64) & (key < 91)) {
                if (guessLength < 5) {
                    let currentGuess[guessLength] = key;
                    do board.putLetterInCell(currentRow, guessLength, key);
                    let guessLength = guessLength + 1;
                } else {
                    do board.clearStatusLine();
                    do Output.printString("Already 5 letters");
                }
            }

            // If all 6 rows used up, end the game
            if (currentRow = 6) {
                do board.clearStatusLine();
                do Output.printString("Word was: ");
                let i = 0;
                while (i < 5) {
                    do Output.printChar(target[i]);
                    let i = i + 1;
                }
            }
            
        }

        return;
    }

    // garbage collection 
    method void dispose() {
        do board.dispose();
        do keyBoard.dispose();
        do wordBank.dispose();
        do currentGuess.dispose();
        do Memory.deAlloc(this);
        return;
    }
}
