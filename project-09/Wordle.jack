class Wordle {

    // the current guess being typed
    field Array currentGuess;
    field int guessLength;      
    field int currentRow;    

    field Array target; 

    field Board board; 
    field WordleKeyboard keyBoard; 
    field WordBank wordBank; 

    constructor Wordle new() {

        let currentGuess = Array.new(5);
        let guessLength = 0;
        let currentRow = 0;

        let wordBank = WordBank.new(); 
        let board = Board.new(); 
        let keyBoard = WordleKeyboard.new(); 
        
        let target = wordBank.pickWord();

        do board.clearStatusLine();

        return this;
    }

    method void run() {
        var char key;
        var int i;

        while (currentRow < 6) {

            let key = keyBoard.getKey();
            while (key = 0) {
                let key = Keyboard.keyPressed();
            }

            // backspace
            if (key = 129) {
                if (guessLength > 0) {
                    let guessLength = guessLength - 1;
                    do board.clearCell(currentRow, guessLength);
                    do board.clearStatusLine();
                }
            }

            // enter
            if (key = 128) {
                if (guessLength = 5) {
                    do showRowFeedback(currentRow);
                    if (isWordCorrect()) {
                        let currentRow = 6;
                    } else {
                        let currentRow = currentRow + 1;
                    }
                    let guessLength = 0;
                } else {
                    do board.clearStatusLine();
                    do Output.printString("Need 5 letters");
                }
            }

            // a-z 
            if ((key > 96) & (key < 123)) {
                if (guessLength < 5) {
                    let currentGuess[guessLength] = key;
                    do board.putLetterInCell(currentRow, guessLength, key);
                    let guessLength = guessLength + 1;
                } else {
                    do board.clearStatusLine();
                    do Output.printString("Already 5 letters");
                }
            }

            // A-Z 
            if ((key > 64) & (key < 91)) {
                if (guessLength < 5) {
                    let currentGuess[guessLength] = key;
                    do board.putLetterInCell(currentRow, guessLength, key);
                    let guessLength = guessLength + 1;
                } else {
                    do board.clearStatusLine();
                    do Output.printString("Already 5 letters");
                }
            }

            // If all 6 rows used up, end the game
            if (currentRow = 6) {
                do board.clearStatusLine();
                do Output.printString("Word was: ");
                let i = 0;
                while (i < 5) {
                    do Output.printChar(target[i]);
                    let i = i + 1;
                }
            }
        }

        return;
    }

    // makes uppercase letter to lowercase 
    method int toLower(int letter) {
        if ((letter > 64) & (letter < 91)) {
            return letter + 32;
        }
        return letter;
    }

    // checks if your guess matches the target word
    method boolean isWordCorrect() {
        var int i;
        let i = 0;
        while (i < 5) {
            if (~(isCorrectPosition(i))) {
                return false;
            }
            let i = i + 1;
        }
        return true;
    }

    // checks if a letter at position is in the word and right place
    method boolean isCorrectPosition(int position) {
        if (toLower(target[position]) = toLower(currentGuess[position])) {
            return true;
        }
        return false;
    }

    // checks if a letter is in the target word but wrong position
    method boolean isInWordWrongPosition(int position) {
        var int i;
        var int letter;
        let letter = toLower(currentGuess[position]);
        
        let i = 0;
        while (i < 5) {
            if ((toLower(target[i]) = letter) & ~(i = position)) {
                return true;
            }
            let i = i + 1;
        }
        return false;
    }

    // feedback symbol for each letter
    method void displayFeedback(int row, int col) {
        var int feedbackChar;
        
        if (isCorrectPosition(col)) {
            let feedbackChar = 86;  // V = correct position and letter
        } else {
            if (isInWordWrongPosition(col)) {
                let feedbackChar = 63;  // ? = wrong position but letter is present
            } else {
                let feedbackChar = 88;  // X = not in word at all
            }
        }
        
        do Output.moveCursor(22, col + 10);
        do Output.printChar(feedbackChar);
        return;
    }

    // show feedback for entire row
    method void showRowFeedback(int row) {
        var int col;
        do board.clearStatusLine(); 
        do Output.moveCursor(22, 0);
        do Output.printString("Feedback: ");
        let col = 0;
        while (col < 5) {
            do displayFeedback(row, col);
            let col = col + 1;
        }
        return;
    }

    // garbage collection 
    method void dispose() {
        do board.dispose();
        do keyBoard.dispose();
        do wordBank.dispose();
        do currentGuess.dispose();
        do Memory.deAlloc(this);
        return;
    }
}