        return this; 
    } 

    method Array getWord(int index) {
        return words[index];
    }

    method int getCount() {
        return count;
    }

    method void dispose() {
        var int i;
        var Array w;
        let i = 0;
        while (i < count) {
            let w = words[i];
            do w.dispose();
            let i = i + 1;
        }
        do words.dispose();
        do Memory.deAlloc(this);
        return;
    }

}